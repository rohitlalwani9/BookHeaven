
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Cart | Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-stone-50 text-stone-800 min-h-screen flex flex-col">

    <%- include('includes/nav.ejs') %>

    <main class="max-w-5xl mx-auto p-6 md:p-10 w-full flex-1">
        <h1 class="text-3xl font-bold mb-8">My Shopping Cart</h1>

        <% if (cart.length === 0) { %>
            <div class="bg-white rounded-xl p-10 text-center shadow-sm">
                <h2 class="text-xl font-semibold mb-3">Your cart is empty</h2>
                <p class="text-stone-500 mb-6">Find your next favourite book.</p>
                <a href="/books"
                   class="inline-block bg-emerald-800 text-white px-6 py-3 rounded-lg hover:bg-emerald-900">
                    Explore Books
                </a>
            </div>
        <% } else { %>

            <div class="space-y-4">
                <% cart.forEach(item => { %>
                    <div class="bg-white rounded-xl p-4 shadow-sm flex gap-4 items-center">
                        <img src="<%= item.image %>"
                             alt="<%= item.name %>"
                             class="w-20 h-28 object-cover rounded">

                        <div class="flex-1">
                            <h2 class="font-semibold text-lg"><%= item.name %></h2>
                            <p class="text-stone-500 mt-1">₹<%= item.price %></p>
                           
<div class="flex items-center gap-3 mt-3">
    <form action="/cart/update/<%= item.bookId %>" method="POST">
        <input type="hidden" name="change" value="-1">
        <button type="submit" class="border rounded px-3 py-1 hover:bg-stone-100">−</button>
    </form>

    <span class="font-semibold"><%= item.quantity %></span>

    <form action="/cart/update/<%= item.bookId %>" method="POST">
        <input type="hidden" name="change" value="1">
        <button type="submit" class="border rounded px-3 py-1 hover:bg-stone-100">+</button>
    </form>
</div>
                            <form action="/cart/remove/<%= item.bookId %>" method="POST" class="mt-3">
                                <button type="submit" class="text-red-600 hover:underline">
                                    Remove
                                </button>
                            </form>
                        </div>

                        <p class="font-bold">
                            ₹<%= item.price * item.quantity %>
                        </p>
                    </div>
                <% }); %>
            </div>

            <div class="bg-white rounded-xl p-6 mt-6 shadow-sm text-right">
                <p class="text-stone-500">Order total</p>
                <p class="text-2xl font-bold mt-1">₹<%= total %></p>
                <button type="button"
                        class="mt-5 bg-emerald-800 text-white px-6 py-3 rounded-lg"
                        onclick="alert('Checkout will be added in the next step!')">
                    Proceed to Checkout
                </button>
            </div>

        <% } %>
    </main>

    <%- include('includes/footer.ejs') %>

</body>
</html>
