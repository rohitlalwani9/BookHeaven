<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Collection | BookHeaven</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-stone-50 text-stone-800">

    <%- include('includes/nav.ejs') %>

    <!-- Page Header -->
    <section class="bg-stone-950 text-white px-6 py-12 md:py-16">
        <div class="max-w-7xl mx-auto">
            <p class="text-amber-400 uppercase tracking-widest text-sm font-semibold">
                The BookHeaven Collection
            </p>

            <h1 class="text-3xl md:text-5xl font-bold mt-3">
                Find Your Next <span class="text-amber-400">Favourite.</span>
            </h1>

            <p class="text-stone-300 mt-4 max-w-2xl">
                Explore our collection of stories, knowledge and inspiration.
                Your next great read is just a click away.
            </p>
        </div>
    </section>

    <!-- Books Collection -->
    <main class="max-w-7xl mx-auto px-5 py-12">

        <div class="flex items-center justify-between gap-4 mb-8">
            <div>
                <h2 class="text-2xl font-bold">Our Books</h2>
                <p class="text-stone-500 text-sm mt-1">
                    Choose a book and add it to your cart.
                </p>
            </div>

            <a href="/category"
               class="text-amber-800 font-semibold hover:text-amber-600 transition">
                Browse Categories →
            </a>
        </div>

        <% if (books.length === 0) { %>

            <div class="bg-white border border-stone-200 rounded-2xl p-10 text-center">
                <p class="text-5xl mb-4">📚</p>
                <h2 class="text-xl font-bold">No books found</h2>
                <p class="text-stone-500 mt-2">
                    There are no books available in this collection yet.
                </p>
                <a href="/books"
                   class="inline-block mt-5 bg-stone-950 text-white px-6 py-3 rounded-lg">
                    View All Books
                </a>
            </div>

        <% } else { %>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5 md:gap-7">

                <% books.forEach(book => { %>

                    <div class="group bg-white border border-stone-200 rounded-2xl overflow-hidden hover:shadow-xl hover:border-amber-300 transition duration-300 flex flex-col">

                        <!-- Book Image -->
                        <div class="h-56 sm:h-64 bg-stone-100 p-4 flex items-center justify-center overflow-hidden">
                            <img
                                src="<%= book.image %>"
                                alt="<%= book.name %>"
                                class="h-full w-full object-contain group-hover:scale-105 transition duration-300">
                        </div>

                        <!-- Book Details -->
                        <div class="p-4 flex flex-col flex-1">

                            <p class="text-xs uppercase tracking-wider text-amber-800 font-semibold mb-2">
                                <%= book.category %>
                            </p>

                            <h3 class="text-base md:text-lg font-bold leading-snug">
                                <%= book.name %>
                            </h3>

                            <% if (book.author) { %>
                                <p class="text-sm text-stone-500 mt-2">
                                    By <%= book.author %>
                                </p>
                            <% } %>

                            <div class="mt-auto pt-5">
                                <p class="text-xl font-bold text-stone-900 mb-4">
                                    ₹<%= book.price %>
                                </p>

                                <form action="/cart/add/<%= book._id %>" method="POST">
                                    <button
                                        type="submit"
                                        class="w-full bg-stone-950 text-white font-semibold py-2.5 px-3 rounded-lg hover:bg-amber-400 hover:text-stone-950 transition">
                                        + Add to Cart
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>

                <% }) %>

            </div>

        <% } %>

        <!-- Bottom Banner -->
        <div class="mt-14 bg-amber-100 border border-amber-200 rounded-2xl p-7 md:p-10 text-center">
            <h2 class="text-2xl font-bold">Found Something You Love?</h2>
            <p class="text-stone-600 mt-2">
                Add it to your cart and keep building your reading list.
            </p>
            <a href="/cart"
               class="inline-block mt-5 bg-stone-950 text-white px-7 py-3 rounded-lg font-semibold hover:bg-stone-800 transition">
                View My Cart →
            </a>
        </div>

    </main>

    <%- include('includes/footer.ejs') %>

</body>
</html>
